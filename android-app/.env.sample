# =============================================================
# Vonage Voice Verify — Android Build Configuration
# =============================================================
# Copy this file to gradle.properties and add at the end:
#   VONAGE_API_KEY=your-api-key
#   VONAGE_API_SECRET=your-api-secret
#   VONAGE_APPLICATION_ID=your-app-id
#   VONAGE_PRIVATE_KEY_PATH=keys/vonage_private.key
#   BACKEND_URL=https://your-vcr-domain.com/
#
# OR pass via command line:
#   ./gradlew assembleRelease \
#     -PVONAGE_API_KEY=xxx \
#     -PVONAGE_API_SECRET=xxx \
#     -PVONAGE_APPLICATION_ID=xxx \
#     -PVONAGE_PRIVATE_KEY_PATH="keys/vonage_private.key" \
#     -PBACKEND_URL=https://your-vcr-domain.com/
# =============================================================

# ─────────────────────────────────────────────────────────────
# 1. Vonage API Credentials
#    → https://dashboard.nvonage.com → API Integrations
# ─────────────────────────────────────────────────────────────
# NOTE: API Secret and Private Key are NEVER stored on the client.
#       Only Application ID (public identifier) is needed here.
VONAGE_APPLICATION_ID=

# ─────────────────────────────────────────────────────────────
# 2. Backend URL (Vonage Cloud Runtime deployment URL)
#    Android app will call this for OTP and voice APIs.
# ─────────────────────────────────────────────────────────────
BACKEND_URL=https://your-vcr-domain.com/

# ─────────────────────────────────────────────────────────────
# 3. Release Signing (keystore for signing the APK)
# ─────────────────────────────────────────────────────────────
# Option A: Place a signing config at android-app/app/signing.properties
#           OR pass via command-line -P flags below.
#
# Option B: Use Android Studio → Build → Generate Signed Bundle / APK
#           → Create new keystore.
#
# Required properties (either in signing.properties or -P flags):
#
# SIGNING_STORE_FILE=../keystore/voiceverify.jks
# SIGNING_STORE_PASSWORD=your-store-password
# SIGNING_KEY_ALIAS=voiceverify-key
# SIGNING_KEY_PASSWORD=your-key-password

# ─────────────────────────────────────────────────────────────
# 4. Android Project Metadata
# ─────────────────────────────────────────────────────────────
APP_NAMESPACE=com.example.voiceverify
APP_APPLICATION_ID=com.example.voiceverify
APP_COMPILE_SDK=34
APP_TARGET_SDK=34
APP_MIN_SDK=24
APP_VERSION_CODE=1
APP_VERSION_NAME=1.0
