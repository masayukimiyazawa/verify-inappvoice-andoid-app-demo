flowchart TB
    REQ(["HTTP Request<br/>(VCREvent: path/method/headers/body)"])
    REQ --> HEALTH{"path == /_/health ?"}
    HEALTH -- Yes --> H200["200 text/plain OK"]
    HEALTH -- No --> CORS{"method == OPTIONS ?"}
    CORS -- Yes --> C204["204 + CORS headers"]
    CORS -- No --> WEBHK{"path == /webhooks/voice-events ?"}
    WEBHK -- Yes --> SIG["verifyWebhookSignature<br/>HMAC-SHA256 / within 5 min / timingSafeEqual"]
    SIG -->|NG 401| RET401A["401 SignatureInvalid"]
    SIG -->|OK / skip| VEH["voiceEventHandler<br/>call_events insert / phone_users update"]
    WEBHK -- No --> RL{"method == POST ?<br/>rate-limit check"}
    RL -- "otp:IP 5 per 5 min<br/>verify:IP 10 per 5 min<br/>call:IP 5 per min<br/>token:IP 10 per min" --> OVER{"exceeded ?"}
    OVER -- Yes --> R429["429 + Retry-After"]
    OVER -- No --> ROUTE["Routing (no auth required)"]
    ROUTE --> SOTP["POST /api/auth/send-otp<br/>handleSendOTP"]
    ROUTE --> VOTP["POST /api/auth/verify-otp<br/>handleVerifyOTP"]
    ROUTE --> LIST["/api/auth/users<br/>handleListUsers"]
    ROUTE --> NCCO["/api/voice/ncco<br/>handleNCCO"]
    ROUTE --> NEEDJWT["others → verifyJWT required<br/>RSA-SHA256 / exp / user.id"]
    NEEDJWT -->|401/500| RET401B["401 Missing/Bearer/Expired"]
    NEEDJWT -->|OK| PROT["Protected routes"]
    PROT --> CALL["POST /api/voice/call<br/>handleInitiateOutgoingCall"]
    PROT --> TOK["POST /api/voice/auth/token<br/>voiceAuth.handler"]
    PROT --> REG["POST /api/voice/register"]
    PROT --> PUSH["POST /api/voice/push-token"]
    PROT --> RECON["POST /api/voice/reconnect"]
    PROT --> NOTFOUND["404 Not Found"]
