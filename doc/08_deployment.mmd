    ENVFILE["android-app/.env (推奨)"]
    PFLAG["Gradle -P フラグ"]
    GPROP["gradle.properties / 環境変数"]
    RESOLVE["BACKEND_URL解決 → BuildConfig埋込<br/>優先: .env > -P > properties > env > localhost"]
    APK["assembleRelease/debug<br/>署名jks (releaseのみ)"]
