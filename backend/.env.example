# =============================================================
# Vonage Voice Verify — Backend Deployment Configuration
# =============================================================
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
# =============================================================

# ─────────────────────────────────────────────────────────────
# 1. Vonage API Credentials (Dashboard / API Integrations)
#    → https://dashboard.vonage.com
# ─────────────────────────────────────────────────────────────
VONAGE_API_KEY=
VONAGE_API_SECRET=

# Vonage Application ID (Voice API)
# Set via Dashboard — does not change after creation.
VONAGE_APPLICATION_ID=

# Vonage Application RSA Private Key (raw contents, NOT a file path)
# If deploying to VCR (Vonage Cloud Runtime):
#   Copy the ENTIRE contents of your private key file (including
#   BEGIN/END lines) and set this variable.
#   The backend reads this directly instead of reading a file.
#
# If deploying to VCR (Vonage Cloud Runtime):
#   There are two ways to provide the RSA key:
#   Option A (recommended): Set VONAGE_PRIVATE_KEY to the raw contents of the key.
#   Option B: Place the key file at a known path in the Git repository
#             (e.g., keys/vonage_private.key) and set VONAGE_PRIVATE_KEY_PATH.
#             VCR's build context includes the repository, so file paths work.
#
# For local development, both options are also available; file path is simpler.
VONAGE_PRIVATE_KEY=
VONAGE_PRIVATE_KEY_PATH=./keys/vonage_private.key

# Brand name displayed to the end-user during calls
VONAGE_BRAND_NAME=VoiceVerify

# Vonage Phone Number (E.164 format, e.g. +818012345678)
# Used as caller ID for outbound PSTN calls and linked to inbound webhooks.
# Purchase at https://dashboard.nvonage.com/number-directory
# Then link to your Voice Application under API Integrations → Voice Settings.
VONAGE_PHONE_NUMBER=

# ─────────────────────────────────────────────────────────────
# 2. MongoDB (Atlas or local)
# ─────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/
MONGODB_DB_NAME=voiceverify

# ─────────────────────────────────────────────────────────────
# 3. Application / Deployment
# ─────────────────────────────────────────────────────────────
# Port (only relevant for local development / tunnel)
PORT=3000

# Allowed CORS origins (comma-separated, or * for development only)
# In production, set to your actual frontend domain(s)
ALLOWED_ORIGINS=*

# ─────────────────────────────────────────────────────────────
# 4. Access Control
# ─────────────────────────────────────────────────────────────
# Only this phone number can log in from the Android app.
# Format: E.164 with + prefix (e.g. +819012345678)
ALLOWED_PHONE_NUMBER=+819012345678

# APP_DOMAIN is NOT used on VCR.
# After deployment, set webhook URLs via:
#   vonage apps:update <app-id> \
#     --voice-answer-url https://<vcr-url>/api/voice/ncco \
#     --voice-event-url https://<vcr-url>/webhooks/voice-events
#
# For local development (e.g. cloudflared tunnel), set APP_DOMAIN:
#   APP_DOMAIN=https://abc123def456.trycloudflare.com
